# ==============================================================================
# CONFIGURAÇÃO DE VARIÁVEIS DE AMBIENTE - VERCEL & SUPABASE
# ==============================================================================

# 1. DATABASE_URL (Supabase Connection Pooler - Porta 6543 / Modo Transaction)
# Utilizada pela aplicação Next.js em produção na Vercel para alta concorrência serverless.
# Obtenha em: Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI (Mode: Transaction / Port 6543)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# 2. DIRECT_URL (Supabase Direct Connection - Porta 5432 / Modo Session)
# Utilizada pelo Prisma CLI para executar migrações e sincronização de schema (prisma db push).
# Obtenha em: Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI (Mode: Session / Port 5432)
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# 3. NEXT_PUBLIC_API_URL (Opcional)
# Em produção na Vercel e em desenvolvimento local, a aplicação usa rotas relativas ("/api").
# Não é necessário preencher a menos que queira apontar para um domínio externo específico.
# NEXT_PUBLIC_API_URL="/api"
